# API key. Required for the default OpenAI endpoint, not needed for a local
# server such as Ollama (set LLM_BASE_URL instead).
LLM_API_KEY=sk-proj-

# Optional: OpenAI-compatible endpoint (defaults to OpenAI)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_BASE_URL=http://localhost:11434/v1

# Optional: model (defaults to gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini

# Optional: timeout per attempt in seconds (defaults to 30)
# LLM_TIMEOUT_SECONDS=30

# Optional: retries on 429, 5xx and timeouts (defaults to 2)
# LLM_MAX_RETRIES=2
